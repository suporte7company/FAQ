*/DEFINE TODOS ARQUIVOS DO BLOCO X CRIADOS, ESTANDO COM STATUS "A" EM "X" QUE NÃO ACUSARA MAIS ERRO NO CAIXA/CADASTRO/*
update PAFEnvWS set Status='X' where Status='A'

*/DEFINE TODAS OS NA COLUNA PARA NÃO FICAREM SENDO IMPRESSAS COMO OS PENDENTE NO CAIXA TODA ABERTURA/FECHAMENTO 
(MODULO OS HOMOLOGADO) FAZER ISSO NÃO FECHA AS OS/*
update osm set paf_status = 'F' where geracao_data<'2024-01-01'

*/DEFINE LISTA DE CHAVES NO XML MANAGER COMO OK (XML COM MAIS DE TRÊS MESES SEM LANÇAR DIFICILMENTE SERÁ LANÇADO) 
NÃO EXCLUIR POIS VAI QUE É NECESSARIO, E APOS ISSO, NO MODULO XML MANAGER, CONFIGS->GERAL = EXIBIR SÓ NÃO OK, 
TAMBEM NO CONFIGURADOR, BUSCAR POR XML E HAVERA FLAG A MARCAR PARA QUE SÓ SEJA MARCADO OK NO XML AO GRAVAR A NF DE COMPRA/*
update xml_lista set OK=True where dataemissao<'2024-01-01' and OK<>True
